# Production environment for The Common Grounds
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=1

# REQUIRED in a public deployment. Generate a long random value.
# Example PowerShell: [Convert]::ToHexString((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional. Leave empty when the frontend is served by this same backend.
# For a separate frontend, use a comma-separated allow-list, e.g.
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Optional database location. The default is backend/data/cafe.db
CG_DATA_DIR=./data
